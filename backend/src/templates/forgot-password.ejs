<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset Your Password - Jus Buy</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f5f6f8;
      font-family: Arial, Helvetica, sans-serif;
      color: #242426;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f5f6f8; padding: 40px 15px"
    >
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 600px;
              width: 100%;
              background-color: #ffffff;
              border-radius: 14px;
              overflow: hidden;
              box-shadow: 0 4px 20px rgba(36, 36, 38, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  padding: 30px 40px;
                  background-color: #242426;
                  text-align: center;
                "
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 30px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                  "
                >
                  Jus Buy
                </h1>

                <p style="margin: 8px 0 0; color: #d6d6d8; font-size: 14px">
                  Your trusted multi-vendor marketplace
                </p>
              </td>
            </tr>

            <!-- Orange Accent -->
            <tr>
              <td
                style="
                  height: 5px;
                  background-color: #ffa915;
                  font-size: 0;
                  line-height: 0;
                "
              >
                &nbsp;
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px">
                <h2 style="margin: 0 0 15px; font-size: 25px; color: #242426">
                  Reset Your Password
                </h2>

                <p
                  style="
                    margin: 0 0 20px;
                    font-size: 15px;
                    line-height: 1.7;
                    color: #55555a;
                  "
                >
                  Hello
                  <strong style="color: #242426"> <%= name %> </strong>,
                </p>

                <p
                  style="
                    margin: 0 0 25px;
                    font-size: 15px;
                    line-height: 1.7;
                    color: #55555a;
                  "
                >
                  We received a request to reset the password for your Jus Buy
                  account. Use the verification code below to continue with your
                  password reset.
                </p>

                <!-- OTP Box -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f5f6f8;
                    border-radius: 12px;
                    border: 1px solid #e5e5e7;
                  "
                >
                  <tr>
                    <td align="center" style="padding: 28px 20px">
                      <p
                        style="
                          margin: 0 0 12px;
                          font-size: 13px;
                          color: #77777c;
                          text-transform: uppercase;
                          letter-spacing: 1.5px;
                          font-weight: 600;
                        "
                      >
                        Your Verification Code
                      </p>

                      <!-- OTP -->
                      <div
                        style="
                          font-size: 36px;
                          font-weight: 700;
                          letter-spacing: 9px;
                          color: #242426;
                        "
                      >
                        <%= otp %>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Expiry Warning -->
                <p
                  style="
                    margin: 22px 0 20px;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #ff5a0a;
                    text-align: center;
                  "
                >
                  This verification code will expire in
                  <strong> <%= expiresIn %> minutes </strong>.
                </p>

                <!-- Information -->
                <p
                  style="
                    margin: 25px 0 0;
                    font-size: 14px;
                    line-height: 1.7;
                    color: #77777c;
                  "
                >
                  If you did not request a password reset, you can safely ignore
                  this email. Your account will remain secure and no changes
                  will be made.
                </p>
              </td>
            </tr>

            <!-- Security Notice -->
            <tr>
              <td
                style="
                  padding: 22px 40px;
                  background-color: #f5f6f8;
                  border-top: 1px solid #e5e5e7;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-size: 13px;
                    line-height: 1.6;
                    color: #66666b;
                  "
                >
                  <strong style="color: #242426"> Security tip: </strong>

                  Never share your verification code with anyone. Jus Buy will
                  never ask you for your OTP by phone, email, or chat.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="padding: 28px 40px; background-color: #242426"
              >
                <p
                  style="
                    margin: 0 0 8px;
                    color: #ffffff;
                    font-size: 15px;
                    font-weight: 700;
                  "
                >
                  Jus Buy
                </p>

                <p
                  style="
                    margin: 0;
                    color: #a5a5aa;
                    font-size: 12px;
                    line-height: 1.5;
                  "
                >
                  © 2026 Jus Buy. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
